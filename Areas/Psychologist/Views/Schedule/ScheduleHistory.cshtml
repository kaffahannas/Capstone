@using LightenUp.Web.Models
@using LightenUp.Web.Models.ViewModels
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Riwayat Jadwal";

    var sessions = ViewBag.Sessions as List<Schedule> ?? new List<Schedule>();
    string? companyName = ViewBag.Company as string;
    string backUrl = string.IsNullOrEmpty(companyName)
        ? "/Psychologist/Dashboard/Index"
        : $"/Psychologist/Dashboard/Index?openCompany={Uri.EscapeDataString(companyName!)}";
    var idCulture = new System.Globalization.CultureInfo("id-ID");
}

@section Head {
    <link rel="stylesheet" href="~/css/psychologist/schedule-schedule-history.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/psychologist/schedule-edit-schedule-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/psychologist/schedule-schedule-detail-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/psychologist/schedule-add-schedule-modal.css" asp-append-version="true" />
}


@* #Bagian RiwayatJadwal# *@
@* #Komponen TombolKembali# *@
<a href="@backUrl" class="back-link">← Kembali ke @(string.IsNullOrEmpty(companyName) ? "Beranda" : "Detail Perusahaan")</a>

<div class="dashboard-header sh-header">
    <div>
        <h1 class="text-header">Riwayat Jadwal Konseling</h1>
        <p class="text-subtitle">Pantau seluruh riwayat dan jadwal konseling client@(string.IsNullOrEmpty(companyName) ? "" : " dari " + companyName).</p>
    </div>
</div>

@if (TempData["success"] is string ok)
{
    <div class="lu-alert-success">@ok</div>
}
@if (TempData["ScheduleSuccess"] is string schedOk)
{
    <div class="lu-alert-success">@schedOk</div>
}

<div class="patient-list-container">
    <div class="sh-toolbar">
        <div class="sh-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-purple)" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="schSearch" placeholder="Cari berdasarkan nama pasien..." class="sh-search-input" />
        </div>
        <button type="button" class="sh-add-btn" onclick="openAddScheduleModal()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Tambah Jadwal
        </button>
    </div>

    @if (!sessions.Any())
    {
        <div class="sh-empty">
            Belum ada riwayat jadwal konseling@(string.IsNullOrEmpty(companyName) ? "" : " untuk " + companyName).
        </div>
    }
    else
    {
        <div id="schList" class="sh-list">
            @{ int idx = 0; }
            @foreach (var s in sessions)
            {
                idx++;
                var displayStatus = s.Status == "Cancelled" ? "Dibatalkan"
                                  : s.Status == "Completed" ? "Selesai"
                                  : (DateTime.Now < s.SessionStart ? "Akan Datang"
                                  : (DateTime.Now <= s.SessionStart.AddMinutes(s.DurationMinutes) ? "On Going" : "Selesai"));
                <div class="history-card sh-card-clickable" data-name="@(s.Patient?.User?.FullName?.ToLowerInvariant() ?? "")" onclick="openScheduleDetailModal(@s.ScheduleId)">
                    <div>
                        <h3>Jadwal Konseling @idx - @displayStatus</h3>
                        <p>@s.SessionStart.ToString("d MMMM yyyy", idCulture) · @(s.Patient?.User?.FullName ?? "—")</p>
                        <p>@s.SessionStart.ToString("HH.mm") - @s.SessionStart.AddMinutes(s.DurationMinutes).ToString("HH.mm")</p>
                        @if (!string.IsNullOrEmpty(s.Notes))
                        {
                            <p class="sh-notes">@s.Notes</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal-overlay" id="scheduleDetailModal">
    <!-- content injected via ajax -->
</div>

@await Html.PartialAsync("_AddScheduleModal", ViewBag.AddScheduleForm as PsyAddScheduleViewModel ?? new PsyAddScheduleViewModel())

<script>
    const input = document.getElementById('schSearch');
    if (input) input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        document.querySelectorAll('#schList .history-card').forEach(c => {
            c.classList.toggle('is-hidden', !c.dataset.name.includes(q));
        });
    });

    window.openScheduleDetailModal = async function(id) {
        try {
            const res = await fetch(`/Psychologist/Schedule/ScheduleDetailModal/${id}`);
            if (!res.ok) throw new Error('Failed to load');
            const html = await res.text();
            document.getElementById('scheduleDetailModal').innerHTML = html;
            document.getElementById('scheduleDetailModal').classList.add('active');
        } catch (err) {
            console.error(err);
            alert("Gagal memuat detail jadwal.");
        }
    }
    window.closeScheduleDetailModal = function() {
        document.getElementById('scheduleDetailModal').classList.remove('active');
    }
    window.openEditScheduleModal = async function(id) {
        try {
            const res = await fetch(`/Psychologist/Schedule/EditScheduleModal/${id}`);
            if (!res.ok) throw new Error('Failed to load');
            const html = await res.text();
            document.getElementById('scheduleDetailModal').innerHTML = html;
        } catch (err) {
            console.error(err);
            alert("Gagal memuat form edit jadwal.");
        }
    }
    window.toggleProofUpload = function(status) {
        var el = document.getElementById('proofUploadContainer');
        if (el) el.style.display = (status === 'Completed') ? 'block' : 'none';
    }
    window.submitEditScheduleForm = function(e) {
        e.preventDefault();
        var form = document.getElementById('editScheduleForm');
        if (!form) return;
        var data = new FormData(form);
        fetch(form.action, { method: 'POST', body: data })
            .then(function(res) {
                if (res.redirected) { window.location.href = res.url; }
                else return res.text().then(function(html) {
                    document.getElementById('scheduleDetailModal').innerHTML = html;
                });
            })
            .then(function() { window.location.reload(); })
            .catch(function() { alert('Gagal menyimpan perubahan.'); });
    }
</script>
