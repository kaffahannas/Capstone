@model LightenUp.Web.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Kata Sandi";
    Layout = null;
}

@* #Bagian Reset Password# *@

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LightenUp</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LightenUp.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/alert-popup.css" asp-append-version="true" />
</head>
<body class="auth-page">

    <div class="auth-wrapper">
        <div class="auth-container register-card register-card--password">

            @* #Komponen Header Reset Password# *@
            <header class="password-header">
                <div class="password-header-text">
                    <h1 class="auth-title password-title">Buat Kata Sandi Baru</h1>
                    <p class="auth-subtitle password-subtitle">Kode OTP terverifikasi. Silakan atur kata sandi baru untuk <strong class="auth-subtitle-email">@Model.Email</strong></p>
                </div>
            </header>

            @* #Komponen Form Reset Password# *@
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Kata Sandi Baru</label>
                    <input asp-for="Password" type="password" class="form-control-custom" placeholder="Minimal 6 karakter" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Konfirmasi Kata Sandi</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control-custom" placeholder="Ulangi kata sandi" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-submit mt-4">Simpan Kata Sandi</button>
            </form>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/shared/alert-popup.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_TempDataAlertPopup")
</body>
</html>
