@{
    // Normalizes the app's inconsistent TempData key naming (success/error/info,
    // SuccessMessage/Error, ScheduleSuccess/ScheduleError, SchedulesSuccess,
    // WorksheetSuccess/WorksheetError) into one popup call. Errors take
    // priority if somehow more than one key is set on the same request.
    string? popupMessage = null;
    string popupType = "success";

    if (TempData.Peek("error") is string e1) { popupMessage = e1; popupType = "error"; }
    else if (TempData.Peek("Error") is string e2) { popupMessage = e2; popupType = "error"; }
    else if (TempData.Peek("ScheduleError") is string e3) { popupMessage = e3; popupType = "error"; }
    else if (TempData.Peek("WorksheetError") is string e4) { popupMessage = e4; popupType = "error"; }
    else if (TempData.Peek("info") is string i1) { popupMessage = i1; popupType = "info"; }
    else if (TempData.Peek("success") is string s1) { popupMessage = s1; popupType = "success"; }
    else if (TempData.Peek("SuccessMessage") is string s2) { popupMessage = s2; popupType = "success"; }
    else if (TempData.Peek("ScheduleSuccess") is string s3) { popupMessage = s3; popupType = "success"; }
    else if (TempData.Peek("SchedulesSuccess") is string s4) { popupMessage = s4; popupType = "success"; }
    else if (TempData.Peek("WorksheetSuccess") is string s5) { popupMessage = s5; popupType = "success"; }
}
@if (popupMessage != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.showAlertPopup(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(popupType)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(popupMessage)));
        });
    </script>
}
